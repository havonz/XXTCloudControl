---
import BaseLayout from '../layouts/BaseLayout.astro';
import latest from '../generated/latest-release.json';
import {
  docsURLForLocale,
  releaseCopy,
  siteLocaleMeta,
  siteLocaleOrder,
  sitePathForLocale,
  type SiteLocale
} from '../i18n';

interface Props {
  locale?: SiteLocale;
  detectLocale?: boolean;
}

const { locale = 'zh-CN', detectLocale = false } = Astro.props;
const text = releaseCopy[locale];

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const withBase = (segment = '') => `${base}${segment.replace(/^\//, '')}`;
const alternates = siteLocaleOrder.map((alternateLocale) => ({
  lang: alternateLocale,
  href: withBase(sitePathForLocale(alternateLocale))
}));
const languagePreferenceKey = 'xxtouch.release.locale.v1';
const localePaths = Object.fromEntries(
  siteLocaleOrder.map((alternateLocale) => [alternateLocale, withBase(sitePathForLocale(alternateLocale))])
);
const screenshotBaseName = locale === 'zh-CN' ? 'screenshot-001' : 'screenshot-001-en';

const releaseVersion = latest.version || '-';
const assets = Array.isArray(latest.assets) ? latest.assets : [];

const formatBytes = (value) => {
  if (!Number.isFinite(value) || value < 0) {
    return '-';
  }

  const units = ['B', 'KB', 'MB', 'GB'];
  let size = value;
  let index = 0;
  while (size >= 1024 && index < units.length - 1) {
    size /= 1024;
    index += 1;
  }
  return `${size.toFixed(index === 0 ? 0 : 2)} ${units[index]}`;
};

---

<BaseLayout title={text.pageTitle} description={text.pageDescription} lang={locale} alternates={alternates}>
  {detectLocale && (
    <script is:inline data-language-redirect define:vars={{ languagePreferenceKey, localePaths }}>
      (() => {
        const supportedLocales = Object.keys(localePaths);
        const supportedLocaleSet = new Set(supportedLocales);
        let selectedLocale;

        try {
          const storedLocale = window.localStorage.getItem(languagePreferenceKey);
          if (storedLocale && supportedLocaleSet.has(storedLocale)) {
            selectedLocale = storedLocale;
          } else if (storedLocale) {
            window.localStorage.removeItem(languagePreferenceKey);
          }
        } catch {
          // 存储不可用时仍应继续按浏览器语言选择。
        }

        const matchBrowserLocale = (language) => {
          const normalized = typeof language === 'string'
            ? language.trim().replace(/_/g, '-').toLowerCase()
            : '';
          if (!normalized) {
            return undefined;
          }

          const parts = normalized.split('-');
          const primaryLanguage = parts[0];
          if (primaryLanguage === 'zh') {
            if (parts.includes('hans')) {
              return supportedLocaleSet.has('zh-CN') ? 'zh-CN' : undefined;
            }
            if (parts.includes('hant') || parts.some((part) => ['tw', 'hk', 'mo'].includes(part))) {
              return supportedLocaleSet.has('zh-TW') ? 'zh-TW' : undefined;
            }
            return supportedLocaleSet.has('zh-CN') ? 'zh-CN' : undefined;
          }

          const exactLocale = supportedLocales.find((candidate) => candidate.toLowerCase() === normalized);
          return exactLocale || supportedLocales.find(
            (candidate) => candidate.toLowerCase().split('-')[0] === primaryLanguage
          );
        };

        if (!selectedLocale) {
          const browserLanguages = [];
          try {
            for (const language of navigator.languages || []) {
              if (typeof language === 'string' && !browserLanguages.includes(language)) {
                browserLanguages.push(language);
              }
            }
            if (typeof navigator.language === 'string' && !browserLanguages.includes(navigator.language)) {
              browserLanguages.push(navigator.language);
            }
          } catch {
            // 浏览器未提供语言信息时使用英语兜底。
          }

          for (const language of browserLanguages) {
            selectedLocale = matchBrowserLocale(language);
            if (selectedLocale) {
              break;
            }
          }
        }

        selectedLocale ||= supportedLocaleSet.has('en-US') ? 'en-US' : supportedLocales[0];
        const targetPath = localePaths[selectedLocale];
        if (!targetPath) {
          return;
        }

        const targetURL = new URL(targetPath, window.location.origin);
        targetURL.search = window.location.search;
        targetURL.hash = window.location.hash;
        const normalizePathname = (pathname) => pathname.endsWith('/') ? pathname : `${pathname}/`;
        if (normalizePathname(targetURL.pathname) !== normalizePathname(window.location.pathname)) {
          window.location.replace(`${targetURL.pathname}${targetURL.search}${targetURL.hash}`);
        }
      })();
    </script>
  )}
  <div class="page-atmosphere" aria-hidden="true"></div>
  <main class="relative mx-auto max-w-6xl px-4 pb-16 pt-8 sm:px-6 lg:px-8 lg:pt-10">
    <header class="mb-6 flex justify-end">
      <nav
        class="language-menu"
        aria-label={text.languageNavLabel}
        data-language-preference-key={languagePreferenceKey}
      >
        <details>
          <summary class="language-menu-trigger">
            <svg class="language-menu-icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3.6 9h16.8M3.6 15h16.8M12 3c2.2 2.4 3.3 5.4 3.3 9S14.2 18.6 12 21M12 3C9.8 5.4 8.7 8.4 8.7 12s1.1 6.6 3.3 9"></path>
            </svg>
            <span class="sr-only">{text.languageNavLabel}: </span>
            <span>{siteLocaleMeta[locale].nativeLabel}</span>
            <svg class="language-menu-chevron" viewBox="0 0 16 16" aria-hidden="true">
              <path d="m4 6 4 4 4-4"></path>
            </svg>
          </summary>
          <div class="language-menu-panel">
            <ul class="language-menu-grid">
              {siteLocaleOrder.map((alternateLocale) => (
                <li>
                  <a
                    href={withBase(sitePathForLocale(alternateLocale))}
                    class={alternateLocale === locale ? 'language-menu-active' : ''}
                    lang={alternateLocale}
                    hreflang={alternateLocale}
                    aria-current={alternateLocale === locale ? 'page' : undefined}
                    data-language-locale={alternateLocale}
                  >
                    {siteLocaleMeta[alternateLocale].nativeLabel}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </details>
      </nav>
    </header>

    <section class="hero-panel mb-8 rounded-3xl p-6 sm:p-8 lg:p-10">
      <div class="relative grid gap-8 lg:grid-cols-[minmax(0,1fr)_15rem] lg:items-start xl:grid-cols-[minmax(0,1fr)_16rem]">
        <div>
          <h1 class="hero-title text-3xl font-black leading-tight sm:text-4xl lg:text-5xl">
            {text.heroTitle}
          </h1>
          <p class="hero-subtitle mt-4 max-w-2xl text-sm leading-7 sm:text-base lg:max-w-3xl">
            {text.heroSubtitle}
          </p>

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={latest.historyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="action-btn action-btn-primary"
            >
              {text.historyBtn}
            </a>
          </div>
        </div>

        <div class="info-grid w-full lg:max-w-[15rem] lg:justify-self-end xl:max-w-[16rem]">
          <article class="info-card">
            <p class="info-label">{text.versionLabel}</p>
            <p class="info-value font-mono text-lg">{releaseVersion}</p>
          </article>
          <article class="info-card">
            <p class="info-label">{text.releaseLabel}</p>
            <a href={latest.releaseUrl} target="_blank" rel="noopener noreferrer" class="info-link">{text.releaseLink}</a>
          </article>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <figure class="screenshot-panel rounded-3xl p-2 sm:p-3">
        <picture>
          <source srcset={withBase(`${screenshotBaseName}-dark.png`)} media="(prefers-color-scheme: dark)" />
          <source srcset={withBase(`${screenshotBaseName}.png`)} media="(prefers-color-scheme: light)" />
          <img
            src={withBase(`${screenshotBaseName}.png`)}
            alt={text.screenshotAlt}
            loading="lazy"
            decoding="async"
            class="screenshot-image block w-full rounded-2xl"
          />
        </picture>
      </figure>
    </section>

    <section class="mb-10">
      <div class="mb-4 flex items-end justify-between gap-4">
        <div>
          <h2 class="section-title text-2xl font-bold">{text.downloadTitle}</h2>
          <p class="section-subtitle mt-1 text-sm">{text.downloadSubtitle}</p>
        </div>
      </div>

      {assets.length === 0 ? (
        <div class="empty-state rounded-2xl p-4 text-sm">{text.noAssets}</div>
      ) : (
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {assets.map((asset) => (
            <article class="download-card rounded-2xl p-5">
              <div class="download-card-head mb-3 flex items-center justify-between gap-3">
                <h3 class="card-title text-lg font-bold">{asset.platform}</h3>
                <span class="size-pill rounded-full px-3 py-1 text-xs font-semibold">
                  {formatBytes(asset.sizeBytes)}
                </span>
              </div>

              <div class="card-meta space-y-3 text-sm">
                <div>
                  <p class="meta-label mb-1 text-xs font-semibold uppercase tracking-wide">{text.fileLabel}</p>
                  <p class="file-name break-all font-mono text-xs">{asset.name}</p>
                </div>

                <div>
                  <p class="meta-label mb-1 text-xs font-semibold uppercase tracking-wide">{text.shaLabel}</p>
                  <div class="sha-row flex gap-2">
                    <code class="sha-code min-w-0 flex-1 rounded-lg px-2 py-1 font-mono text-[10px] tracking-tight">
                      {asset.sha256 || '-'}
                    </code>
                    <button
                      type="button"
                      class="copy-btn shrink-0 px-2 sm:px-3"
                      data-copy={asset.sha256 || ''}
                      data-default={text.copyBtn}
                      data-success={text.copiedBtn}
                      data-manual={text.copyManuallyPrompt}
                      disabled={!asset.sha256}
                    >
                      {text.copyBtn}
                    </button>
                  </div>
                </div>
              </div>

              <a
                href={asset.downloadUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="action-btn action-btn-primary mt-4 w-full justify-center"
              >
                {text.downloadBtn}
              </a>
            </article>
          ))}
        </div>
      )}
    </section>

    <section class="guide-panel rounded-3xl p-6">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="section-title text-2xl font-bold">{text.quickStartTitle}</h2>
          <p class="section-subtitle mt-1 text-sm">{text.quickStartSubtitle}</p>
        </div>
        <a
          href={docsURLForLocale(locale)}
          target="_blank"
          rel="noopener noreferrer"
          class="action-btn action-btn-secondary"
        >
          {text.docsBtn}
        </a>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {text.guideItems.map((item) => (
          <article class="guide-item rounded-xl px-4 py-3">
            <h3 class="guide-item-title font-semibold">{item.title}</h3>
            <p class="guide-item-body mt-1 text-sm leading-6">{item.body}</p>
          </article>
        ))}
      </div>
    </section>
  </main>

  <script>
    const languageMenu = document.querySelector('[data-language-preference-key]');
    const languagePreferenceKey = languageMenu?.getAttribute('data-language-preference-key');
    if (languageMenu && languagePreferenceKey) {
      for (const link of languageMenu.querySelectorAll('[data-language-locale]')) {
        link.addEventListener('click', () => {
          const selectedLocale = link.getAttribute('data-language-locale');
          if (!selectedLocale) {
            return;
          }
          try {
            window.localStorage.setItem(languagePreferenceKey, selectedLocale);
          } catch {
            // 即使无法保存偏好，普通链接仍能正常切换语言。
          }
        });
      }
    }

    const copyButtons = Array.from(document.querySelectorAll('[data-copy]'));
    for (const button of copyButtons) {
      button.addEventListener('click', async () => {
        const text = button.getAttribute('data-copy') || '';
        if (!text) {
          return;
        }

        const defaultText = button.getAttribute('data-default') || 'Copy';
        const successText = button.getAttribute('data-success') || 'Copied';
        const manualPrompt = button.getAttribute('data-manual') || 'Copy manually:';

        try {
          await navigator.clipboard.writeText(text);
          button.textContent = successText;
          setTimeout(() => {
            button.textContent = defaultText;
          }, 1200);
        } catch {
          window.prompt(manualPrompt, text);
        }
      });
    }
  </script>
</BaseLayout>
