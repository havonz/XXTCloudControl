---
import '../styles/global.css';

interface AlternateLink {
  lang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  lang?: string;
  alternates?: AlternateLink[];
}

const { title, description, lang = 'zh-CN', alternates = [] } = Astro.props;
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const withBase = (segment = '') => `${base}${segment.replace(/^\//, '')}`;
const absoluteURL = (href: string) => new URL(href, Astro.site);
---

<!doctype html>
<html lang={lang} class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={absoluteURL(alternate.href)} />
    ))}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={absoluteURL(alternates[0].href)} />
    )}
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('favicon-16.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('favicon-32.png')} />
  </head>
  <body class="min-h-full font-sans antialiased">
    <slot />
  </body>
</html>
